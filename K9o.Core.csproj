<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>K9o</RootNamespace>
    <AssemblyName>K9o.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackageId>K9o.Core</PackageId>
    <Version>1.4.0</Version>
    <Title>k9o — Kilimanjaro platform SDK</Title>
    <Description>Kilimanjaro platform SDK — createClient + data DSL + projects + gate + Studio (workflows/dashboards) + Compute.Llms + Realtime subscriptions + KError. .NET idiomatic (PascalCase Async methods; throw KError : Exception; HttpClient; IAsyncEnumerable for SSE).</Description>
    <Authors>Kilimanjaro</Authors>
    <Company>Kilimanjaro</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://kilimanjaro.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/k9o-dev/sdk-dotnet</RepositoryUrl>
    <PackageTags>kilimanjaro;k9o;sdk;platform</PackageTags>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

</Project>
